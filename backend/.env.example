# ==============================================
# NexCart Backend Environment Configuration Example
# ==============================================

# Server Configuration
PORT=8000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database Configuration (MongoDB connection string)
DB_URI=mongodb://localhost:27017/nexcart

# Authentication / JWT Configuration
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_EXPIRY=1d
REFRESH_TOKEN_KEY=your_refresh_token_secret_key_here
REFRESH_TOKEN_EXPIRY=10d
COOKIE_EXPIRY=10

# Email Service (Supports 'smtp' or 'brevo')
EMAIL_PROVIDER=smtp
# If EMAIL_PROVIDER=smtp:
SMTP_SERVICE=gmail
SMTP_MAIL=your_email@example.com
SMTP_PASSWORD=your_email_app_password
# If EMAIL_PROVIDER=brevo (HTTPS API for cloud platforms blocking SMTP):
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_NAME=NexCart
BREVO_SENDER_EMAIL=your_verified_brevo_sender_email@example.com

# Cloudinary (Media Storage for avatars and product images)
CLOUDINARY_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# Razorpay (Payment Gateway)
RAZORPAY_API_KEY=your_razorpay_key_id
RAZORPAY_API_SECRET=your_razorpay_key_secret
